---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveMediaUrl } from '../../lib/media';

export async function getStaticPaths() {
  const entries = await getCollection('photos');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, subtitle, coverImage, gallery } = entry.data;

// Curated pool of motorsport frames with natural interspersed horizontal (4:3) and vertical (3:4) orientations
const availableImages = [
  { src: '/images/photos/apex-motion-01.svg', alt: 'Turn 4 sunset panning', aspect: 'landscape' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Kerb geometry and brake glow', aspect: 'portrait' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Conrod straight high-speed descent', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Apex entry trajectory', aspect: 'landscape' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Chicane dynamic balance', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Parc fermé evening solitude', aspect: 'landscape' },
  { src: '/images/hero/slide-02.svg', alt: 'Pit lane nocturnal reflections', aspect: 'portrait' },
  { src: '/images/photos/motorsport-06.svg', alt: 'Centerlock wheel change', aspect: 'landscape' },
  { src: '/images/hero/slide-03.svg', alt: 'Grid formation under morning mist', aspect: 'landscape' },
  { src: '/images/photos/motorsport-07.svg', alt: 'Aerodynamic wake and vortex trail', aspect: 'portrait' },
  { src: '/images/hero/slide-04.svg', alt: 'Sprint pack into hairpin', aspect: 'landscape' },
  { src: '/images/hero/slide-05.svg', alt: 'Telemetry analysis in garage', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-01.svg', alt: 'Late apex brake glow', aspect: 'landscape' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Full throttle acceleration zone', aspect: 'portrait' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Suspension compression over kerb', aspect: 'landscape' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Headlight beams in spray', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Twilight race restart', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Pit wall timing boards', aspect: 'landscape' },
  { src: '/images/hero/slide-02.svg', alt: 'Mechanic wheel change reflex', aspect: 'portrait' },
  { src: '/images/photos/motorsport-06.svg', alt: 'Tire temperature heat cycle', aspect: 'landscape' },
  { src: '/images/hero/slide-03.svg', alt: 'Podium champagne spray', aspect: 'landscape' },
  { src: '/images/photos/motorsport-07.svg', alt: 'Rear diffuser carbon weave', aspect: 'portrait' },
  { src: '/images/hero/slide-04.svg', alt: 'Overtake on the inside line', aspect: 'landscape' },
  { src: '/images/hero/slide-05.svg', alt: 'Cockpit telemetry monitor', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-01.svg', alt: 'Golden hour panning streak', aspect: 'landscape' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Downshift flame from exhaust', aspect: 'landscape' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Front splitter aero deflection', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Race director flag signals', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Cool down lap wave to fans', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Post-race tire marbles on tarmac', aspect: 'landscape' },
];

const seriesGallery =
  gallery && gallery.length > 0
    ? gallery.map((g) => ({
        src: resolveMediaUrl(g.src),
        alt: g.alt || g.caption || title,
        aspect: g.aspect === 'portrait' ? 'portrait' : 'landscape',
      }))
    : [];

const fillerNeeded = seriesGallery.length <= 2 ? Math.max(0, 30 - seriesGallery.length) : 0;
const galleryImages = [
  ...seriesGallery,
  ...availableImages.slice(0, fillerNeeded),
];
---

<BaseLayout title={title} description={subtitle}>
  <article class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 pb-20">
    <!-- Back Link -->
    <a
      href="/gallery"
      class="inline-flex items-center gap-1.5 font-mono text-xs text-secondary transition hover:text-white"
    >
      <span>&larr;</span>
      <span>Back to Portfolio</span>
    </a>

    <!-- Header: Title only -->
    <header data-reveal data-reveal-delay="40" class="mt-4">
      <h1 class="font-display text-4xl text-surface-100 sm:text-5xl lg:text-6xl font-medium tracking-tight">
        {title}
      </h1>
    </header>

    <!-- Waterfall (Masonry) Gallery (30 images, 4:3 landscape & 3:4 portrait) -->
    <div id="gallery-waterfall" data-reveal data-reveal-delay="150" data-series-slug={entry.slug} class="mt-8 sm:mt-10 columns-1 sm:columns-2 lg:columns-3 gap-4 sm:gap-6">
      {galleryImages.map((item, index) => {
        const isPortrait = item.aspect === 'portrait';
        return (
          <div
            class="group relative mb-4 sm:mb-6 break-inside-avoid overflow-hidden rounded-xl border border-secondary/20 bg-surface-900/60 shadow-lg shadow-black/40 transition-all duration-300 hover:border-secondary/40"
          >
            <div class:list={[
              'relative w-full overflow-hidden',
              isPortrait ? 'aspect-[3/4]' : 'aspect-[4/3]',
            ]}>
              <img
                src={item.src}
                alt={item.alt}
                loading={index < 6 ? 'eager' : 'lazy'}
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-102"
              />
            </div>
          </div>
        );
      })}
    </div>
  </article>

  <script is:inline>
    (function applyGalleryDraftPreview() {
      try {
        const params = new URLSearchParams(window.location.search);
        if (params.get('preview') !== 'draft') return;

        const waterfall = document.getElementById('gallery-waterfall');
        if (!waterfall) return;
        const slug = waterfall.dataset.seriesSlug;
        const raw = localStorage.getItem(`darkroom_preview_${slug}`);
        if (!raw) return;

        const draft = JSON.parse(raw);
        if (draft && Array.isArray(draft.frames)) {
          waterfall.innerHTML = '';
          draft.frames.forEach((item) => {
            const isPortrait = item.aspect === 'portrait';
            const card = document.createElement('div');
            card.className =
              'group relative mb-4 sm:mb-6 break-inside-avoid overflow-hidden rounded-xl border border-secondary/20 bg-surface-900/60 shadow-lg shadow-black/40 transition-all duration-300 hover:border-secondary/40';

            const box = document.createElement('div');
            box.className = `relative w-full overflow-hidden ${isPortrait ? 'aspect-[3/4]' : 'aspect-[4/3]'}`;

            const img = document.createElement('img');
            img.src = item.src;
            img.alt = item.alt || 'Gallery Frame';
            img.className = 'h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-102';

            box.appendChild(img);
            card.appendChild(box);
            waterfall.appendChild(card);
          });
        }

        const banner = document.createElement('div');
        banner.className =
          'fixed bottom-5 left-5 z-50 flex items-center gap-3 rounded-full border border-amber-400/40 bg-surface-950/95 px-4 py-2 text-xs font-medium text-amber-300 shadow-2xl backdrop-blur-md';
        banner.innerHTML =
          '<span class="h-2 w-2 rounded-full bg-amber-400"></span><span>Draft Preview — Unsaved Darkroom Changes</span>';
        document.body.appendChild(banner);
      } catch (_) {}
    })();
  </script>
</BaseLayout>
