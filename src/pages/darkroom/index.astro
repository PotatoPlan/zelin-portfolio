    const unsavedSlugs = new Set();

    function updateActionButtonsState() {
      const isDirty = unsavedSlugs.has(currentSectionSlug);
      viewLiveBtn.disabled = !isDirty;
      savePublishBtn.disabled = !isDirty;
      if (isDirty) {
        saveStatusDot.classList.remove('bg-emerald-500');
        saveStatusDot.classList.add('bg-amber-400');
        saveBtnText.textContent = 'Save Changes (Unsaved)';
      } else {
        saveStatusDot.classList.remove('bg-amber-400');
        saveStatusDot.classList.add('bg-emerald-500');
        saveBtnText.textContent = 'Save Changes';
      }
    }

    function markUnsaved(slug = currentSectionSlug) {
      unsavedSlugs.add(slug);
      updateActionButtonsState();
    }

    function markSaved(slug = currentSectionSlug) {
      unsavedSlugs.delete(slug);
