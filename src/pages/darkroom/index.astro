      } else {
        panel.classList.add('hidden');
        panel.innerHTML = '';
        return;
      }

      // Bind copy inputs
      panel.querySelectorAll('[data-copy-key]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const key = e.target.dataset.copyKey;
          if (key === 'fullBio') {
            section.copy.fullBio = e.target.value
              .split(/\n\s*\n/)
              .map((p) => p.trim())
              .filter(Boolean);
          } else {
            section.copy[key] = e.target.value;
          }
          markUnsaved(section.slug);
        });
      });

      // Bind series meta inputs
      panel.querySelectorAll('[data-series-key]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const key = e.target.dataset.seriesKey;
          section.seriesMeta[key] = e.target.value;
          if (key === 'title') {
            section.title = e.target.value;
            const coverTitleEl = document.getElementById('cover-preview-title');
            if (coverTitleEl) coverTitleEl.textContent = e.target.value;
          }
          markUnsaved(section.slug);
        });
      });

      // Bind experience fields
      panel.querySelectorAll('[data-exp-field]').forEach((el) => {
        const evt = el.tagName === 'SELECT' ? 'change' : 'input';
        el.addEventListener(evt, (e) => {
          const idx = Number(e.target.dataset.expIdx);
          const field = e.target.dataset.expField;
          if (!section.experiences[idx]) return;
          if (field === 'highlights') {
            section.experiences[idx].highlights = e.target.value
              .split('\n')
              .map((line) => line.trim())
              .filter(Boolean);
          } else {
            section.experiences[idx][field] = e.target.value;
          }
          markUnsaved(section.slug);
        });
      });

      const addExpBtn = panel.querySelector('#btn-add-exp');
      if (addExpBtn) {
        addExpBtn.addEventListener('click', () => {
          section.experiences = section.experiences || [];
          section.experiences.push({
            slug: `experience-${Date.now()}`,
            role: 'New Role / Project',
            organization: 'Organization',
            type: 'Photography & Creative',
            period: '2026',
            location: 'Melbourne, AU',
            current: false,
            summary: '',
            highlights: [],
          });
          markUnsaved(section.slug);
          renderTextEditor(section);
        });
      }

      panel.querySelectorAll('.btn-del-exp').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.expIdx);
          if (confirm(`Remove Experience #${idx + 1}?`)) {
            section.experiences.splice(idx, 1);
            markUnsaved(section.slug);
            renderTextEditor(section);
          }
        });
      });

      // Bind About Series I've Worked With inputs
      panel.querySelectorAll('[data-about-series-field]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const idx = Number(e.target.dataset.sIdx);
          const field = e.target.dataset.aboutSeriesField;
          if (section.aboutMap?.series?.[idx]) {
            section.aboutMap.series[idx][field] = e.target.value;
            markUnsaved(section.slug);
          }
        });
      });

      const addAboutSeriesBtn = panel.querySelector('#btn-add-about-series');
      if (addAboutSeriesBtn) {
        addAboutSeriesBtn.addEventListener('click', () => {
          section.aboutMap = section.aboutMap || { series: [], tracks: [] };
          section.aboutMap.series.push({
            id: `series-${Date.now()}`,
            title: 'New Series',
            subtitle: 'Short description of this series.',
          });
          markUnsaved(section.slug);
          renderTextEditor(section);
        });
      }

      panel.querySelectorAll('.btn-del-about-series').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.sIdx);
          const removed = section.aboutMap?.series?.[idx];
          if (removed && confirm(`Remove series "${removed.title}"?`)) {
            section.aboutMap.series.splice(idx, 1);
            markUnsaved(section.slug);
            renderTextEditor(section);
          }
        });
      });

      // Bind Track Name & Dot Parameter inputs
      panel.querySelectorAll('[data-track-field]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const idx = Number(e.target.dataset.tIdx);
          const field = e.target.dataset.trackField;
          if (!section.aboutMap?.tracks?.[idx]) return;
          if (field === 'name') {
            section.aboutMap.tracks[idx].name = e.target.value;
          } else {
            section.aboutMap.tracks[idx][field] = parseFloat(e.target.value) || 0;
          }
          markUnsaved(section.slug);
        });
      });

      panel.querySelectorAll('.track-series-chk').forEach((chk) => {
        chk.addEventListener('change', (e) => {
          const idx = Number(e.target.dataset.tIdx);
          const sId = e.target.dataset.seriesId;
          const track = section.aboutMap?.tracks?.[idx];
          if (!track) return;
          track.seriesIds = Array.isArray(track.seriesIds) ? track.seriesIds : [];
          if (e.target.checked) {
            if (!track.seriesIds.includes(sId)) track.seriesIds.push(sId);
          } else {
            track.seriesIds = track.seriesIds.filter((id) => id !== sId);
          }
          markUnsaved(section.slug);
          renderTextEditor(section);
        });
      });

      const addTrackBtn = panel.querySelector('#btn-add-about-track');
      if (addTrackBtn) {
        addTrackBtn.addEventListener('click', () => {
          section.aboutMap = section.aboutMap || { series: [], tracks: [] };
          section.aboutMap.tracks.push({
            id: `track-${Date.now()}`,
            name: 'New Circuit',
            lat: -37.85,
            lon: 144.97,
            dx: 0,
            dy: 0,
            seriesIds: [],
          });
          markUnsaved(section.slug);
          renderTextEditor(section);
        });
      }

      panel.querySelectorAll('.btn-del-about-track').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.tIdx);
          const removed = section.aboutMap?.tracks?.[idx];
          if (removed && confirm(`Remove track "${removed.name}"?`)) {
            section.aboutMap.tracks.splice(idx, 1);
            markUnsaved(section.slug);
            renderTextEditor(section);
          }
        });
      });
    }

    function renderFrames() {
      const section = getCurrentSection();
      if (!section) return;

      updateActiveTabHighlight();
      updateActionButtonsState();
      renderTextEditor(section);
      sectionViewTitle.textContent = `${section.title} (${section.group})`;

      const dropzoneSectionEl = document.getElementById('dropzone-section');
      const waterfallSectionEl = document.getElementById('waterfall-section');
      if (section.isTextOnly) {
        dropzoneSectionEl.classList.add('hidden');
        waterfallSectionEl.classList.add('hidden');
        addFrameBtn.classList.add('hidden');
        statsCounter.textContent = `Editing text copy for "${section.title}"`;
      } else {
        dropzoneSectionEl.classList.remove('hidden');
        waterfallSectionEl.classList.remove('hidden');
        addFrameBtn.classList.toggle('hidden', section.slug === 'about-photo');
      }

      const profile = getOptimizationProfile(section.slug);
      optimizerProfileLabel.textContent = profile.label;

      // Show & populate Portfolio Cover Card section on Gallery Pages only
      const coverSectionEl = document.getElementById('portfolio-cover-section');
      const coverPreviewImg = document.getElementById('cover-preview-img');
      const coverPreviewScaleWrap = document.getElementById('cover-preview-scale-wrap');
      const coverPreviewTitle = document.getElementById('cover-preview-title');
      if (section.group === 'Gallery Pages' && section.cover) {
        coverSectionEl.classList.remove('hidden');
        coverPreviewImg.src = section.cover.src;
        const cx = typeof section.cover.focusX === 'number' ? section.cover.focusX : 50;
        const cy = typeof section.cover.focusY === 'number' ? section.cover.focusY : 50;
        const cz = typeof section.cover.zoom === 'number' ? section.cover.zoom : 1;
        coverPreviewImg.style.objectPosition = `${cx}% ${cy}%`;
        coverPreviewScaleWrap.style.transform = `scale(${cz})`;
        coverPreviewScaleWrap.style.transformOrigin = `${cx}% ${cy}%`;
        coverPreviewTitle.textContent = section.title;
      } else {
        coverSectionEl.classList.add('hidden');
      }

      let landscapes = 0;
      let portraits = 0;
      section.frames.forEach((f) => {
        if (f.aspect === 'portrait') portraits++;
        else landscapes++;
      });

      if (!section.isTextOnly) {
        statsCounter.textContent = `${section.frames.length} Frames in "${section.title}" (${landscapes} Landscape 4:3, ${portraits} Portrait 3:4)`;
      }

      waterfall.innerHTML = '';

      section.frames.forEach((frame, idx) => {
        const isPortrait = frame.aspect === 'portrait';
        const card = document.createElement('div');
        card.className =
          'frame-card group relative overflow-hidden rounded-xl border border-secondary/25 bg-surface-900/90 shadow-lg transition-all duration-200 hover:border-secondary/60 hover:shadow-2xl';
        card.setAttribute('draggable', 'true');
        card.dataset.index = idx;

        const isHeroSection = section.slug === 'home-hero';
        const focusX = typeof frame.focusX === 'number' ? frame.focusX : 65;
        const focusY = typeof frame.focusY === 'number' ? frame.focusY : 50;
        const zoom = typeof frame.zoom === 'number' ? frame.zoom : 1;

        const editFramingBtnHtml = isHeroSection
          ? `<button
               type="button"
               class="btn-edit-framing shrink-0 inline-flex items-center gap-1 rounded-md border border-secondary/40 bg-surface-950/90 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-sm transition hover:bg-surface-850 hover:border-white"
               title="Visually adjust crop position for the Hero Carousel"
             >
               <span>✂ Edit</span>
             </button>`
          : '';

        const conversionBadgeHtml = frame.conversionMeta
          ? `<div class="pointer-events-auto inline-flex items-center gap-2 rounded-md border border-emerald-500/40 bg-surface-950/90 px-2 py-1 text-[10px] font-medium text-emerald-300 shadow-md backdrop-blur-sm">
               <span>${frame.conversionMeta}</span>
               <a href="${frame.src}" download="${frame.fileName || `frame-${idx + 1}.webp`}" class="underline hover:text-white" title="Download optimized WebP for Azure">.webp ↓</a>
             </div>`
          : '';

        card.innerHTML = `
          <!-- Card Header & Drag Bar -->
          <div class="flex h-9 items-center justify-between border-b border-secondary/15 bg-surface-950/70 px-3 text-xs">
            <div class="flex items-center gap-2 cursor-grab active:cursor-grabbing handle">
              <span class="text-secondary/50">⠿</span>
              <span class="font-semibold text-surface-100">#${String(idx + 1).padStart(2, '0')}</span>
            </div>
            
            <div class="flex items-center gap-1.5">
              <!-- Reorder buttons -->
              <button type="button" class="btn-move-up rounded p-1 text-secondary transition hover:bg-secondary/15 hover:text-white" title="Move frame earlier">
                ←
              </button>
              <button type="button" class="btn-move-down rounded p-1 text-secondary transition hover:bg-secondary/15 hover:text-white" title="Move frame later">
                →
              </button>
              <button type="button" class="btn-delete rounded p-1 text-red-400 transition hover:bg-red-950/50 hover:text-red-300" title="Delete frame">
                ✕
              </button>
            </div>
          </div>

          <!-- Image Preview with Exact Aspect Ratio -->
          <div class="relative w-full overflow-hidden ${isPortrait ? 'aspect-[3/4]' : 'aspect-[4/3]'} bg-stone-950">
            <img
              src="${frame.src}"
              alt="${frame.alt || 'Frame preview'}"
              style="${isHeroSection ? `object-position: ${focusX}% ${focusY}%; transform: scale(${zoom}); transform-origin: ${focusX}% ${focusY}%;` : ''}"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-102"
            />
            
            <!-- Quick Floating Action Overlay (zero layout impact) -->
            <div class="absolute inset-0 flex flex-col justify-between p-2.5 bg-gradient-to-t from-black/80 via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <!-- Orientation Toggle Badge -->
              <div class="flex justify-start">
                <button
                  type="button"
                  class="btn-toggle-aspect inline-flex items-center gap-1.5 rounded-full border border-secondary/40 bg-surface-950/90 px-2.5 py-1 text-[11px] font-semibold text-white shadow-md backdrop-blur-sm transition hover:bg-white hover:text-surface-950"
                  title="Click to toggle between 4:3 (Horizontal) and 3:4 (Vertical)"
                >
                  <span>⇄</span>
                  <span>${isPortrait ? '3:4 Portrait' : '4:3 Landscape'}</span>
                </button>
              </div>

              <!-- Bottom Overlay Row: Optimization Pill (if any), Edit Framing (Hero only) & Replace Button -->
              <div class="flex items-end justify-between gap-2">
                <div class="min-w-0">
                  ${conversionBadgeHtml}
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${editFramingBtnHtml}
                  <button
                    type="button"
                    class="btn-replace shrink-0 inline-flex items-center gap-1.5 rounded-md border border-secondary/40 bg-surface-950/90 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-sm transition hover:bg-surface-850 hover:border-white"
                  >
                    <span>📷 Replace</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Card Footer & Description / Alt (fixed height so grid stays uniform) -->
          <div class="p-2.5 bg-surface-900/60">
            <input
              type="text"
              value="${frame.alt || ''}"
              placeholder="Frame title / description..."
              class="frame-alt-input h-8 w-full rounded border border-secondary/20 bg-surface-950/80 px-2.5 text-xs text-surface-100 placeholder:text-secondary/50 focus:border-surface-100 focus:outline-none"
            />
          </div>
        `;

        // Event Listeners for Card
        const toggleAspectBtn = card.querySelector('.btn-toggle-aspect');
        toggleAspectBtn.addEventListener('click', () => {
          frame.aspect = frame.aspect === 'portrait' ? 'landscape' : 'portrait';
          markUnsaved();
          renderFrames();
        });

        const replaceBtn = card.querySelector('.btn-replace');
        replaceBtn.addEventListener('click', () => {
          replaceTargetIndex = idx;
          singleReplaceInput.click();
        });

        const editFramingBtn = card.querySelector('.btn-edit-framing');
        if (editFramingBtn) {
          editFramingBtn.addEventListener('click', () => {
            openHeroCropModal(idx);
          });
        }

        const moveUpBtn = card.querySelector('.btn-move-up');
        moveUpBtn.addEventListener('click', () => {
          if (idx > 0) {
            const temp = section.frames[idx];
            section.frames[idx] = section.frames[idx - 1];
            section.frames[idx - 1] = temp;
            markUnsaved();
            renderFrames();
          }
        });

        const moveDownBtn = card.querySelector('.btn-move-down');
        moveDownBtn.addEventListener('click', () => {
          if (idx < section.frames.length - 1) {
            const temp = section.frames[idx];
            section.frames[idx] = section.frames[idx + 1];
            section.frames[idx + 1] = temp;
            markUnsaved();
            renderFrames();
          }
        });

        const deleteBtn = card.querySelector('.btn-delete');
        deleteBtn.addEventListener('click', () => {
          if (confirm(`Remove Frame #${idx + 1}?`)) {
            section.frames.splice(idx, 1);
            markUnsaved();
            renderFrames();
          }
        });

        const altInput = card.querySelector('.frame-alt-input');
        altInput.addEventListener('input', (e) => {
          frame.alt = e.target.value;
          markUnsaved();
        });

        // Drag & Drop Reordering
        card.addEventListener('dragstart', (e) => {
          draggedIndex = idx;
          card.classList.add('opacity-40');
          e.dataTransfer.effectAllowed = 'move';
        });

        card.addEventListener('dragend', () => {
          card.classList.remove('opacity-40');
          document.querySelectorAll('.frame-card').forEach((c) => c.classList.remove('border-white', 'scale-[1.02]'));
        });

        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          card.classList.add('border-white');
        });

        card.addEventListener('dragleave', () => {
          card.classList.remove('border-white');
        });

        card.addEventListener('drop', (e) => {
          e.preventDefault();
          card.classList.remove('border-white');
          if (draggedIndex !== null && draggedIndex !== idx) {
            const movedItem = section.frames.splice(draggedIndex, 1)[0];
            section.frames.splice(idx, 0, movedItem);
            draggedIndex = null;
            markUnsaved();
            renderFrames();
          }
        });

        waterfall.appendChild(card);
      });
    }

    // Category Tabs Switching
    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        currentSectionSlug = tab.dataset.slug;
        sessionStorage.setItem('darkroom_active_slug', currentSectionSlug);
        history.replaceState(null, '', `#${currentSectionSlug}`);
        renderFrames();
      });
    });

    // Single File Replace Handler with Automatic WebP Optimization
    singleReplaceInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file && replaceTargetIndex !== null) {
        const targetIdx = replaceTargetIndex;
        replaceTargetIndex = null;
        singleReplaceInput.value = '';

        try {
          showToast('Optimizing image to WebP...');
          const section = getCurrentSection();
          const optimized = await optimizeImageForAzure(file, section.slug);
          section.frames[targetIdx].src = optimized.src;
          section.frames[targetIdx].dataUrl = optimized.dataUrl;
          section.frames[targetIdx].alt = optimized.alt;
          section.frames[targetIdx].aspect = section.slug === 'about-photo' ? 'portrait' : optimized.aspect;
          section.frames[targetIdx].fileName = optimized.fileName;
          section.frames[targetIdx].conversionMeta = optimized.conversionMeta;
          markUnsaved();
          renderFrames();
          showToast(`Optimized & replaced (${optimized.conversionMeta})`);
        } catch (err) {
          showToast('Could not process image file');
        }
      }
    });

    // Helper for processing multiple files (sorted naturally by filename so order is deterministic)
    async function handleBulkFiles(fileList) {
      const files = Array.from(fileList)
        .filter((f) => f.type.startsWith('image/'))
        .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
      if (files.length === 0) return;

      const section = getCurrentSection();
      showToast(`Optimizing ${files.length} photo(s) to WebP...`);

      let addedCount = 0;
      for (const file of files) {
        try {
          const optimized = await optimizeImageForAzure(file, section.slug);
          if (section.slug === 'about-photo') {
            section.frames[0] = {
              src: optimized.src,
              dataUrl: optimized.dataUrl,
              alt: optimized.alt,
              aspect: 'portrait',
              fileName: optimized.fileName,
              conversionMeta: optimized.conversionMeta,
              focusX: 50,
              focusY: 50,
              zoom: 1,
            };
            addedCount = 1;
            break;
          }
          section.frames.push({
            src: optimized.src,
            dataUrl: optimized.dataUrl,
            alt: optimized.alt,
            aspect: optimized.aspect,
            fileName: optimized.fileName,
            conversionMeta: optimized.conversionMeta,
          });
          addedCount++;
        } catch (err) {
          // Skip invalid files
        }
      }

      if (addedCount > 0) {
        markUnsaved();
        renderFrames();
        showToast(`Optimized & added ${addedCount} WebP frame(s)!`);
      }
    }

    // Bulk File Input Change Handler
    bulkFileInput.addEventListener('change', async (e) => {
      await handleBulkFiles(e.target.files);
      bulkFileInput.value = '';
    });

    // Drag & Drop File Support directly onto the Dropzone
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-surface-100', 'bg-surface-900/80');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-surface-100', 'bg-surface-900/80');
    });

    dropzone.addEventListener('drop', async (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-surface-100', 'bg-surface-900/80');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        await handleBulkFiles(e.dataTransfer.files);
      }
    });

    // Add Empty / Placeholder Frame Button
    addFrameBtn.addEventListener('click', () => {
      const section = getCurrentSection();
      section.frames.push({
        src: '/images/photos/apex-motion-01.svg',
        alt: 'New frame',
        aspect: section.frames.length % 2 === 0 ? 'landscape' : 'portrait',
      });
      markUnsaved();
      renderFrames();
      showToast('New frame added to bottom!');
    });

    // Reset Button
    resetBtn.addEventListener('click', () => {
      if (confirm('Discard all unsaved edits and reset to saved state?')) {
        sectionsState = JSON.parse(JSON.stringify(initialSectionsData));
        unsavedSlugs.clear();
        Object.keys(localStorage).forEach((k) => {
          if (k.startsWith('darkroom_preview_')) localStorage.removeItem(k);
        });
        updateActionButtonsState();
        renderFrames();
        showToast('Reset to saved configuration');
      }
    });

    async function saveCurrentSection() {
      saveBtnText.textContent = 'Saving...';
      const section = getCurrentSection();
      sessionStorage.setItem('darkroom_active_slug', section.slug);
      history.replaceState(null, '', `#${section.slug}`);
      try {
        const res = await fetch('/api/darkroom/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: section.slug,
            frames: section.frames,
            cover: section.cover || null,
            copy: section.copy || null,
            experiences: section.experiences || null,
            seriesMeta: section.seriesMeta || null,
            aboutMap: section.aboutMap || null,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.error || `Server returned ${res.status}`);
        }

        // Update local state with persisted disk URLs so blob URLs are replaced
        if (Array.isArray(data.frames)) {
          section.frames = data.frames;
        }
        if (data.cover) {
          section.cover = data.cover;
        }
        localStorage.removeItem(`darkroom_preview_${section.slug}`);
        renderFrames();
        markSaved(section.slug);
        showToast(`Saved & synced "${section.title}" to site!`);
        return true;
      } catch (err) {
        updateActionButtonsState();
        showToast(`Save failed: ${err.message || 'Could not reach save API'}`);
        return false;
      }
    }

    // Save & Publish Button
    savePublishBtn.addEventListener('click', async () => {
      if (!unsavedSlugs.has(currentSectionSlug)) return;
      await saveCurrentSection();
    });

    // Preview Live: open a non-destructive draft preview tab with saved + current unsaved changes
    viewLiveBtn.addEventListener('click', () => {
      const section = getCurrentSection();
      if (!section || !unsavedSlugs.has(section.slug)) return;

      const draftPayload = {
        slug: section.slug,
        title: section.title,
        copy: section.copy || null,
        experiences: section.experiences || null,
        seriesMeta: section.seriesMeta || null,
        aboutMap: section.aboutMap || null,
        frames: section.frames.map((f) => ({
          ...f,
          src: f.dataUrl || f.src,
        })),
        cover: section.cover
          ? {
              ...section.cover,
              src: section.cover.dataUrl || section.cover.src,
            }
          : null,
      };

      try {
        localStorage.setItem(`darkroom_preview_${section.slug}`, JSON.stringify(draftPayload));
      } catch (err) {
        showToast('Draft too large for browser preview storage; save to view live.');
        return;
      }

      const rawUrl = section.liveUrl || '/';
      const [pathPart, hashPart] = rawUrl.split('#');
      const sep = pathPart.includes('?') ? '&' : '?';
      const previewUrl = `${pathPart}${sep}preview=draft${hashPart ? `#${hashPart}` : ''}`;
      window.open(previewUrl, '_blank', 'noopener');
    });

    // Portfolio Cover Card Actions (Gallery Series only)
    const coverEditFramingBtn = document.getElementById('cover-edit-framing-btn');
    const coverReplaceBtn = document.getElementById('cover-replace-btn');
    const coverReplaceInput = document.getElementById('cover-replace-input');

    coverEditFramingBtn.addEventListener('click', () => {
      openCoverCropModal();
    });

    coverReplaceBtn.addEventListener('click', () => {
      coverReplaceInput.click();
    });

    coverReplaceInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      coverReplaceInput.value = '';
      if (!file) return;
      try {
        showToast('Optimizing cover image to WebP...');
        const section = getCurrentSection();
        // Use high-res hero-class profile (max 2400px) for full-width Portfolio cover banners
        const optimized = await optimizeImageForAzure(file, 'home-hero');
        section.cover = {
          src: optimized.src,
          dataUrl: optimized.dataUrl,
          fileName: optimized.fileName,
          focusX: 50,
          focusY: 50,
          zoom: 1,
        };
        markUnsaved(section.slug);
        renderFrames();
        showToast('Cover image optimized & staged!');
      } catch (err) {
        showToast('Could not process cover image');
      }
    });

    // Visual Framing Modal State & Drag-to-Pan Logic (shared by Hero Carousel & Portfolio Cover Card)
    const heroCropModal = document.getElementById('hero-crop-modal');
    const heroCropTitle = document.getElementById('hero-crop-title');
    const heroCropStage = document.getElementById('hero-crop-stage');
    const heroCropMaskWrap = document.getElementById('hero-crop-mask-wrap');
    const coverCropGradient = document.getElementById('cover-crop-gradient');
    const heroCropGuide = document.getElementById('hero-crop-guide');
    const coverCropGuide = document.getElementById('cover-crop-guide');
    const coverCropGuideTitle = document.getElementById('cover-crop-guide-title');
    const heroCropImg = document.getElementById('hero-crop-img');
    const heroCropCoords = document.getElementById('hero-crop-coords');
    const heroCropZoom = document.getElementById('hero-crop-zoom');
    const heroCropZoomVal = document.getElementById('hero-crop-zoom-val');
    const heroCropReset = document.getElementById('hero-crop-reset');
    const heroCropCancel = document.getElementById('hero-crop-cancel');
    const heroCropApply = document.getElementById('hero-crop-apply');

    let cropMode = 'hero'; // 'hero' | 'cover'
    let cropTargetIndex = null;
    let cropFocusX = 65;
    let cropFocusY = 50;
    let cropZoom = 1;
    let isPanningCrop = false;
    let panStartX = 0;
    let panStartY = 0;
    let panInitialFocusX = 65;
    let panInitialFocusY = 50;

    function updateCropPreview() {
      const x = Math.max(0, Math.min(100, Math.round(cropFocusX)));
      const y = Math.max(0, Math.min(100, Math.round(cropFocusY)));
      const z = Math.max(1, Math.min(2, Number(cropZoom)));
      cropFocusX = x;
      cropFocusY = y;
      cropZoom = z;
      heroCropImg.style.objectPosition = `${x}% ${y}%`;
      heroCropImg.style.transform = `scale(${z})`;
      heroCropImg.style.transformOrigin = `${x}% ${y}%`;
      heroCropZoom.value = String(z);
      heroCropZoomVal.textContent = `${Math.round(z * 100)}%`;
      heroCropCoords.textContent = `${x}% · ${y}% · ${Math.round(z * 100)}%`;
    }

    function openHeroCropModal(idx) {
      const section = getCurrentSection();
      const frame = section.frames[idx];
      if (!frame) return;

      cropMode = 'hero';
      cropTargetIndex = idx;
      heroCropTitle.textContent = 'Adjust Hero Carousel Framing';
      heroCropStage.classList.remove('aspect-[11/2]');
      heroCropStage.classList.add('aspect-[5/2]');
      heroCropMaskWrap.style.webkitMaskImage =
        'radial-gradient(ellipse 82% 115% at 10% 22%, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.28) 14%, rgba(0,0,0,0.36) 28%, rgba(0,0,0,0.50) 42%, rgba(0,0,0,0.68) 56%, rgba(0,0,0,0.85) 70%, rgba(0,0,0,0.96) 84%, black 95%), linear-gradient(to bottom, transparent 0%, black 6%, black 92%, transparent 100%)';
      heroCropMaskWrap.style.maskImage = heroCropMaskWrap.style.webkitMaskImage;
      coverCropGradient.classList.add('hidden');
      heroCropGuide.classList.remove('hidden');
      coverCropGuide.classList.add('hidden');

      cropFocusX = typeof frame.focusX === 'number' ? frame.focusX : 65;
      cropFocusY = typeof frame.focusY === 'number' ? frame.focusY : 50;
      cropZoom = typeof frame.zoom === 'number' ? frame.zoom : 1;
      heroCropImg.src = frame.src;
      updateCropPreview();

      heroCropModal.classList.remove('hidden');
      heroCropModal.classList.add('flex');
    }

    function openCoverCropModal() {
      const section = getCurrentSection();
      if (!section.cover) return;

      cropMode = 'cover';
      cropTargetIndex = null;
      heroCropTitle.textContent = `Adjust Portfolio Cover Framing — ${section.title}`;
      heroCropStage.classList.remove('aspect-[5/2]');
      heroCropStage.classList.add('aspect-[11/2]');
      heroCropMaskWrap.style.webkitMaskImage = 'none';
      heroCropMaskWrap.style.maskImage = 'none';
      coverCropGradient.classList.remove('hidden');
      heroCropGuide.classList.add('hidden');
      coverCropGuide.classList.remove('hidden');
      coverCropGuideTitle.textContent = section.title;

      cropFocusX = typeof section.cover.focusX === 'number' ? section.cover.focusX : 50;
      cropFocusY = typeof section.cover.focusY === 'number' ? section.cover.focusY : 50;
      cropZoom = typeof section.cover.zoom === 'number' ? section.cover.zoom : 1;
      heroCropImg.src = section.cover.src;
      updateCropPreview();

      heroCropModal.classList.remove('hidden');
      heroCropModal.classList.add('flex');
    }

    function closeHeroCropModal() {
      heroCropModal.classList.add('hidden');
      heroCropModal.classList.remove('flex');
      cropTargetIndex = null;
      isPanningCrop = false;
    }

    heroCropStage.addEventListener('pointerdown', (e) => {
      isPanningCrop = true;
      panStartX = e.clientX;
      panStartY = e.clientY;
      panInitialFocusX = cropFocusX;
      panInitialFocusY = cropFocusY;
      heroCropStage.setPointerCapture(e.pointerId);
    });

    heroCropStage.addEventListener('pointermove', (e) => {
      if (!isPanningCrop) return;
      const rect = heroCropStage.getBoundingClientRect();
      const dxPct = ((e.clientX - panStartX) / rect.width) * 100;
      const dyPct = ((e.clientY - panStartY) / rect.height) * 100;
      cropFocusX = panInitialFocusX - dxPct;
      cropFocusY = panInitialFocusY - dyPct;
      updateCropPreview();
    });

    heroCropStage.addEventListener('pointerup', (e) => {
      isPanningCrop = false;
      if (heroCropStage.hasPointerCapture(e.pointerId)) {
        heroCropStage.releasePointerCapture(e.pointerId);
      }
    });

    heroCropZoom.addEventListener('input', (e) => {
      cropZoom = parseFloat(e.target.value) || 1;
      updateCropPreview();
    });

    heroCropReset.addEventListener('click', () => {
      cropFocusX = 50;
      cropFocusY = 50;
      cropZoom = 1;
      updateCropPreview();
    });

    heroCropCancel.addEventListener('click', closeHeroCropModal);

    heroCropModal.addEventListener('click', (e) => {
      if (e.target === heroCropModal) closeHeroCropModal();
    });

    heroCropApply.addEventListener('click', () => {
      const section = getCurrentSection();
      if (cropMode === 'cover' && section.cover) {
        section.cover.focusX = cropFocusX;
        section.cover.focusY = cropFocusY;
        section.cover.zoom = cropZoom;
        markUnsaved(section.slug);
        renderFrames();
        closeHeroCropModal();
        showToast(`Staged cover framing (${cropFocusX}% · ${cropFocusY}% · ${Math.round(cropZoom * 100)}%)`);
      } else if (cropTargetIndex !== null) {
        section.frames[cropTargetIndex].focusX = cropFocusX;
        section.frames[cropTargetIndex].focusY = cropFocusY;
        section.frames[cropTargetIndex].zoom = cropZoom;
        markUnsaved(section.slug);
        renderFrames();
        closeHeroCropModal();
        showToast(`Staged hero framing (${cropFocusX}% · ${cropFocusY}% · ${Math.round(cropZoom * 100)}%)`);
      } else {
        closeHeroCropModal();
      }
    });

    // Check Azure SWA session identity (/.auth/me) when hosted on Azure; silently skipped on localhost
    (async function checkAzureAdminSession() {
      try {
        const res = await fetch('/.auth/me');
        if (!res.ok) return;
        const data = await res.json().catch(() => null);
        const principal = data && data.clientPrincipal;
        if (principal && principal.userDetails) {
          const badge = document.getElementById('darkroom-auth-badge');
          const userEl = document.getElementById('darkroom-auth-user');
          if (badge && userEl) {
            userEl.textContent = principal.userDetails;
            badge.classList.remove('hidden');
            badge.classList.add('inline-flex');
          }
        }
      } catch (_) {}
    })();

    // Initial Render
    renderFrames();
  </script>
</BaseLayout>
