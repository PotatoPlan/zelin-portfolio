---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveMediaUrl } from '../../lib/media';
import homeHeroData from '../../data/homeHero.json';
import homeGalleryData from '../../data/homeGallery.json';
import aboutProfileData from '../../data/aboutProfile.json';
import pageCopy from '../../data/pageCopy.json';
import aboutSeriesMap from '../../data/aboutSeriesMap.json';
import packageJson from '../../../package.json';

const appVersion = packageJson.version;

const allSeries = (await getCollection('photos')).sort(
  (a, b) => a.data.order - b.data.order
);

const allExperiences = (await getCollection('experiences'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((exp) => ({
    slug: exp.slug,
    role: exp.data.role,
    organization: exp.data.organization,
    type: exp.data.type,
    period: exp.data.period,
    location: exp.data.location,
    current: exp.data.current,
    summary: exp.data.summary,
    highlights: exp.data.highlights || [],
  }));

// Default motorsport frames pool used for fillers when a series has fewer frames
const defaultPool = [
  { src: '/images/photos/apex-motion-01.svg', alt: 'Turn 4 sunset panning', aspect: 'landscape' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Kerb geometry and brake glow', aspect: 'portrait' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Conrod straight high-speed descent', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Apex entry trajectory', aspect: 'landscape' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Chicane dynamic balance', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Parc fermé evening solitude', aspect: 'landscape' },
  { src: '/images/hero/slide-02.svg', alt: 'Pit lane nocturnal reflections', aspect: 'portrait' },
  { src: '/images/photos/motorsport-06.svg', alt: 'Centerlock wheel change', aspect: 'landscape' },
  { src: '/images/hero/slide-03.svg', alt: 'Grid formation under morning mist', aspect: 'landscape' },
  { src: '/images/photos/motorsport-07.svg', alt: 'Aerodynamic wake and vortex trail', aspect: 'portrait' },
  { src: '/images/hero/slide-04.svg', alt: 'Sprint pack into hairpin', aspect: 'landscape' },
  { src: '/images/hero/slide-05.svg', alt: 'Telemetry analysis in garage', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-01.svg', alt: 'Late apex brake glow', aspect: 'landscape' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Full throttle acceleration zone', aspect: 'portrait' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Suspension compression over kerb', aspect: 'landscape' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Headlight beams in spray', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Twilight race restart', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Pit wall timing boards', aspect: 'landscape' },
  { src: '/images/hero/slide-02.svg', alt: 'Mechanic wheel change reflex', aspect: 'portrait' },
  { src: '/images/photos/motorsport-06.svg', alt: 'Tire temperature heat cycle', aspect: 'landscape' },
  { src: '/images/hero/slide-03.svg', alt: 'Podium champagne spray', aspect: 'landscape' },
  { src: '/images/photos/motorsport-07.svg', alt: 'Rear diffuser carbon weave', aspect: 'portrait' },
  { src: '/images/hero/slide-04.svg', alt: 'Overtake on the inside line', aspect: 'landscape' },
  { src: '/images/hero/slide-05.svg', alt: 'Cockpit telemetry monitor', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-01.svg', alt: 'Golden hour panning streak', aspect: 'landscape' },
  { src: '/images/photos/motorsport-03.svg', alt: 'Downshift flame from exhaust', aspect: 'landscape' },
  { src: '/images/photos/motorsport-04.svg', alt: 'Front splitter aero deflection', aspect: 'portrait' },
  { src: '/images/photos/motorsport-05.svg', alt: 'Race director flag signals', aspect: 'landscape' },
  { src: '/images/hero/slide-01.svg', alt: 'Cool down lap wave to fans', aspect: 'portrait' },
  { src: '/images/photos/apex-motion-02.svg', alt: 'Post-race tire marbles on tarmac', aspect: 'landscape' },
];

const gallerySeriesData = allSeries.map((s) => {
  const existingGallery = (s.data.gallery || []).map((g) => ({
    src: resolveMediaUrl(g.src),
    alt: g.alt || g.caption || s.data.title,
    aspect: g.aspect === 'portrait' ? 'portrait' : 'landscape',
  }));

  const fillerNeeded = Math.max(0, 30 - existingGallery.length);
  const fullGallery = [
    ...existingGallery,
    ...defaultPool.slice(0, fillerNeeded),
  ];

  return {
    slug: s.slug,
    title: s.data.title,
    group: 'Gallery Pages',
    liveUrl: `/gallery/${s.slug}`,
    coverImage: resolveMediaUrl(s.data.coverImage),
    seriesMeta: {
      title: s.data.title,
      subtitle: s.data.subtitle,
    },
    cover: {
      src: resolveMediaUrl(s.data.coverImage),
      focusX: typeof s.data.coverFocusX === 'number' ? s.data.coverFocusX : 50,
      focusY: typeof s.data.coverFocusY === 'number' ? s.data.coverFocusY : 50,
      zoom: typeof s.data.coverZoom === 'number' ? s.data.coverZoom : 1,
    },
    frames: fullGallery,
  };
});

const homeHeroSection = {
  slug: 'home-hero',
  title: 'Home Hero Carousel',
  group: 'Homepage',
  liveUrl: '/',
  coverImage: homeHeroData[0]?.src || '/images/hero/slide-01.svg',
  copy: { ...pageCopy.homeHero },
  frames: homeHeroData.map((h) => ({
    src: resolveMediaUrl(h.src),
    alt: h.title || h.alt || 'Hero Slide',
    aspect: h.aspect === 'portrait' ? 'portrait' : 'landscape',
    meta: h.meta || '',
    focusX: typeof (h as any).focusX === 'number' ? (h as any).focusX : 65,
    focusY: typeof (h as any).focusY === 'number' ? (h as any).focusY : 50,
    zoom: typeof (h as any).zoom === 'number' ? (h as any).zoom : 1,
  })),
};

const homeGallerySection = {
  slug: 'home-gallery',
  title: 'Home Gallery',
  group: 'Homepage',
  liveUrl: '/#gallery-archive',
  coverImage: homeGalleryData[0]?.src || '/images/hero/slide-01.svg',
  frames: homeGalleryData.map((g) => ({
    src: resolveMediaUrl(g.src),
    alt: g.title || g.alt || 'Gallery Frame',
    aspect: g.aspect === 'portrait' ? 'portrait' : 'landscape',
    meta: g.meta || '',
    category: g.category || 'Motorsport',
  })),
};

const homeAgencySection = {
  slug: 'home-agency',
  title: 'Home Agency',
  group: 'Homepage',
  liveUrl: '/',
  isTextOnly: true,
  copy: { ...pageCopy.homeAgency },
  frames: [],
};

const portfolioPageSection = {
  slug: 'portfolio-page',
  title: 'Portfolio Header',
  group: 'Homepage',
  liveUrl: '/gallery',
  isTextOnly: true,
  copy: { ...pageCopy.portfolioHeader },
  frames: [],
};

const aboutPhotoSection = {
  slug: 'about-photo',
  title: 'About Page',
  group: 'Homepage',
  liveUrl: '/about',
  coverImage: resolveMediaUrl(aboutProfileData.src),
  copy: {
    ...pageCopy.aboutIntro,
    fullBio: [...pageCopy.aboutIntro.fullBio],
  },
  experiences: allExperiences,
  aboutMap: aboutSeriesMap,
  frames: [
    {
      src: resolveMediaUrl(aboutProfileData.src),
      alt: aboutProfileData.alt || 'Shu Zelin — Trackside Portrait',
      aspect: 'portrait',
      focusX: typeof aboutProfileData.focusX === 'number' ? aboutProfileData.focusX : 50,
      focusY: typeof aboutProfileData.focusY === 'number' ? aboutProfileData.focusY : 50,
      zoom: typeof aboutProfileData.zoom === 'number' ? aboutProfileData.zoom : 1,
    },
  ],
};

const allSections = [
  homeHeroSection,
  homeGallerySection,
  homeAgencySection,
  portfolioPageSection,
  aboutPhotoSection,
  ...gallerySeriesData,
];
---

<BaseLayout title="The Darkroom" description="Private Visual Curation Desk">
  <div class="min-h-screen bg-surface-950 pb-28 font-sans text-surface-100">
    <!-- Top Persistent Control Bar -->
    <header class="sticky top-0 z-50 border-b border-secondary/20 bg-surface-950/95 backdrop-blur-md py-3.5 shadow-xl">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 sm:px-8">
        <!-- Brand / Context -->
        <div class="flex items-center">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base font-semibold tracking-tight text-white">The Darkroom</h1>
              <span class="rounded-full border border-secondary/30 bg-surface-900 px-2.5 py-0.5 text-[11px] font-medium text-secondary">
                Private Curation Desk
              </span>
              <span
                id="darkroom-version-badge"
                class="rounded-full border border-secondary/25 bg-surface-900/70 px-2 py-0.5 font-mono text-[11px] font-medium text-secondary-light"
                title="Application version (SemVer)"
              >
                v{appVersion}
              </span>
              <span id="darkroom-auth-badge" class="hidden items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/30 px-2.5 py-0.5 text-[11px] text-emerald-300">
                <span id="darkroom-auth-user"></span>
                <a href="/.auth/logout?post_logout_redirect_uri=/" class="underline hover:text-white">Sign Out</a>
              </span>
            </div>
            <p id="stats-counter" class="text-xs text-secondary">Loading frames...</p>
          </div>
        </div>

        <!-- Global Action Buttons -->
        <div class="flex flex-wrap items-center gap-2.5">
          <button
            id="add-frame-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/30 bg-surface-900 px-3.5 py-1.5 text-xs font-medium text-surface-100 transition hover:border-secondary/60 hover:bg-surface-850"
          >
            <span>+</span>
            <span>Add Frame</span>
          </button>

          <button
            id="view-live-btn"
            type="button"
            disabled
            class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/30 bg-surface-900 px-3.5 py-1.5 text-xs font-medium text-surface-100 transition hover:border-secondary hover:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-secondary/30 disabled:hover:text-surface-100"
            title="Preview your unsaved changes live without publishing"
          >
            <span>Preview Live ↗</span>
          </button>

          <button
            id="reset-btn"
            type="button"
            class="rounded-lg border border-secondary/20 px-3.5 py-1.5 text-xs font-medium text-secondary transition hover:bg-surface-900 hover:text-white"
          >
            Reset
          </button>

          <button
            id="save-publish-btn"
            type="button"
            disabled
            class="inline-flex items-center gap-2 rounded-lg bg-surface-100 px-4 py-1.5 text-xs font-semibold text-surface-950 shadow-md transition hover:bg-white active:scale-98 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-surface-100"
          >
            <span id="save-status-dot" class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <span id="save-btn-text">Save Changes</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Workspace -->
    <main class="mx-auto max-w-7xl px-4 sm:px-8 pt-8">
      <!-- Category Switcher Tabs Grouped -->
      <section data-reveal data-reveal-delay="40" class="mb-8 space-y-5">
        <!-- Homepage Group -->
        <div>
          <div class="flex items-center justify-between pb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-surface-200">Homepage Sections</span>
            <span class="text-xs text-secondary">Main landing page imagery</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {allSections.filter((s) => s.group === 'Homepage').map((s) => (
              <button
                type="button"
                data-slug={s.slug}
                class="category-tab rounded-xl border border-secondary/25 bg-surface-900/80 px-4 py-2 text-xs font-medium text-secondary hover:border-secondary/50 hover:text-white transition-all duration-200"
              >
                {s.title}
              </button>
            ))}
          </div>
        </div>

        <!-- Gallery Pages Group -->
        <div>
          <div class="flex items-center justify-between pb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-surface-200">Gallery Series</span>
            <span class="text-xs text-secondary">Individual motorsport categories</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {allSections.filter((s) => s.group === 'Gallery Pages').map((s) => (
              <button
                type="button"
                data-slug={s.slug}
                class="category-tab rounded-xl border border-secondary/25 bg-surface-900/80 px-4 py-2 text-xs font-medium text-secondary hover:border-secondary/50 hover:text-white transition-all duration-200"
              >
                {s.title}
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Dynamic Text & Content Editor Panel -->
      <section id="text-editor-panel" class="mb-8 hidden"></section>

      <!-- Drag & Drop Bulk Upload Zone + Azure WebP Conversion Pipeline -->
      <section id="dropzone-section" data-reveal data-reveal-delay="130" class="mb-8">
        <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
            <span class="text-xs font-medium text-surface-200">
              Azure Smart Image Optimizer Active
            </span>
          </div>
          <span id="optimizer-profile-label" class="text-xs text-secondary">
            Auto-converts uploads to WebP · Max 1600px (2400px Hero) · Target ≤ 280 KB
          </span>
        </div>

        <label
          for="bulk-file-input"
          id="dropzone"
          class="group flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-secondary/30 bg-surface-900/40 p-6 text-center transition-all duration-200 hover:border-surface-100 hover:bg-surface-900/70"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-full border border-secondary/30 bg-surface-850 text-secondary transition-colors group-hover:border-surface-100 group-hover:text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="mt-3 text-sm font-medium text-surface-100">
            Drop new photos here or click to browse
          </span>
          <span class="mt-1 text-xs text-secondary">
            Automatically resizes, compresses to high-clarity WebP for Azure hosting, and detects 4:3 / 3:4 orientation
          </span>
          <input
            id="bulk-file-input"
            type="file"
            multiple
            accept="image/*"
            class="hidden"
          />
        </label>
      </section>

      <!-- Portfolio Cover Card Editor (Gallery Series only) -->
      <section id="portfolio-cover-section" class="mb-8 hidden">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-surface-200">Portfolio Cover Card</h2>
            <span class="text-xs text-secondary">(Shown on the /gallery Portfolio list)</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="cover-edit-framing-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/30 bg-surface-900 px-3 py-1.5 text-xs font-medium text-white transition hover:border-white hover:bg-surface-850"
            >
              <span>✂ Edit Framing</span>
            </button>
            <button
              id="cover-replace-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/30 bg-surface-900 px-3 py-1.5 text-xs font-medium text-white transition hover:border-white hover:bg-surface-850"
            >
              <span>📷 Replace Cover</span>
            </button>
          </div>
        </div>

        <div class="relative min-h-[140px] sm:aspect-[11/2] w-full overflow-hidden rounded-2xl border border-secondary/25 bg-surface-900 shadow-lg">
          <div id="cover-preview-scale-wrap" class="h-full w-full">
            <img
              id="cover-preview-img"
              src=""
              alt="Portfolio cover preview"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-surface-950/85 via-surface-950/35 to-transparent"></div>
          <div class="pointer-events-none relative z-10 flex h-full flex-col justify-start p-6 sm:p-7 md:p-8">
            <h3 id="cover-preview-title" class="font-display text-2xl sm:text-3xl font-medium tracking-tight text-surface-100">
              Series Title
            </h3>
          </div>
        </div>
      </section>

      <!-- Waterfall Masonry Visual Workspace -->
      <section id="waterfall-section" data-reveal data-reveal-delay="210">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-4 border-b border-secondary/15 pb-3">
          <div class="flex items-center gap-2">
            <h2 id="section-view-title" class="text-lg font-semibold tracking-tight text-white">Waterfall Grid Layout</h2>
            <span class="text-xs text-secondary">(Exact live proportions & arrangement)</span>
          </div>
          <p class="text-xs text-secondary">
            Drag cards to reorder · Toggle 4:3 ⇄ 3:4 · Click Replace to swap & optimize photo
          </p>
        </div>

        <!-- Ordered Grid Container (strictly #01 to #0x left-to-right, top-to-bottom) -->
        <div
          id="frames-waterfall"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-start"
        >
          <!-- Dynamically populated via JavaScript for instant drag/reorder/toggle -->
        </div>
      </section>
    </main>

    <!-- Hidden Single File Input for In-Card "Replace" Action & Cover Replace -->
    <input id="single-replace-input" type="file" accept="image/*" class="hidden" />
    <input id="cover-replace-input" type="file" accept="image/*" class="hidden" />

    <!-- Hero Carousel Visual Framing Modal (Home Hero Carousel only) -->
    <div
      id="hero-crop-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-labelledby="hero-crop-title"
    >
      <div class="w-full max-w-4xl overflow-hidden rounded-2xl border border-secondary/30 bg-surface-900 shadow-2xl">
        <div class="flex items-center justify-between border-b border-secondary/20 px-5 py-3.5">
          <div>
            <h3 id="hero-crop-title" class="text-sm font-semibold text-white">Adjust Hero Carousel Framing</h3>
            <p class="text-xs text-secondary">Drag the image to position what appears in the wide hero banner</p>
          </div>
          <span id="hero-crop-coords" class="rounded-md border border-secondary/25 bg-surface-950 px-2.5 py-1 text-xs text-surface-200">
            65% · 50%
          </span>
        </div>

        <div class="p-5 space-y-4">
          <!-- Exact 5:2 Hero Banner or 11:2 Portfolio Cover Preview -->
          <div
            id="hero-crop-stage"
            class="relative w-full aspect-[5/2] cursor-grab active:cursor-grabbing overflow-hidden rounded-xl border border-secondary/30 bg-[#17191c] select-none"
          >
            <div
              id="hero-crop-mask-wrap"
              class="h-full w-full pointer-events-none"
              style="-webkit-mask-image: radial-gradient(ellipse 82% 115% at 10% 22%, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.28) 14%, rgba(0,0,0,0.36) 28%, rgba(0,0,0,0.50) 42%, rgba(0,0,0,0.68) 56%, rgba(0,0,0,0.85) 70%, rgba(0,0,0,0.96) 84%, black 95%), linear-gradient(to bottom, transparent 0%, black 6%, black 92%, transparent 100%); mask-image: radial-gradient(ellipse 82% 115% at 10% 22%, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.28) 14%, rgba(0,0,0,0.36) 28%, rgba(0,0,0,0.50) 42%, rgba(0,0,0,0.68) 56%, rgba(0,0,0,0.85) 70%, rgba(0,0,0,0.96) 84%, black 95%), linear-gradient(to bottom, transparent 0%, black 6%, black 92%, transparent 100%); -webkit-mask-composite: destination-in; mask-composite: intersect;"
            >
              <img
                id="hero-crop-img"
                src=""
                alt="Framing preview"
                draggable="false"
                class="h-full w-full object-cover pointer-events-none"
              />
            </div>
            <!-- Cover Card Gradient Overlay (visible in cover mode) -->
            <div
              id="cover-crop-gradient"
              class="pointer-events-none absolute inset-0 hidden bg-gradient-to-br from-surface-950/85 via-surface-950/35 to-transparent"
            ></div>
            <!-- Ghosted Top-Left Hero Guide -->
            <div id="hero-crop-guide" class="pointer-events-none absolute left-6 top-6 max-w-[44%] drop-shadow-[0_2px_10px_rgba(0,0,0,0.65)]">
              <div class="text-sm sm:text-base font-medium text-white">Motorsport Images at Paddocker</div>
              <div class="mt-1 text-[10px] text-white/90">Motorsport photography trackside and in the paddock.</div>
              <div class="mt-3 inline-block rounded-full bg-surface-100 px-3 py-1 text-[10px] font-semibold text-surface-950">
                Download Portfolio PDF
              </div>
            </div>
            <!-- Ghosted Top-Left Cover Card Guide -->
            <div id="cover-crop-guide" class="pointer-events-none absolute left-6 top-5 hidden">
              <div id="cover-crop-guide-title" class="font-display text-2xl font-medium tracking-tight text-surface-100">Series Title</div>
            </div>
          </div>

          <!-- Zoom Slider -->
          <div class="flex items-center gap-4">
            <label for="hero-crop-zoom" class="text-xs font-medium text-secondary whitespace-nowrap">Zoom</label>
            <input
              id="hero-crop-zoom"
              type="range"
              min="1"
              max="2"
              step="0.02"
              value="1"
              class="h-1.5 w-full cursor-pointer accent-surface-100"
            />
            <span id="hero-crop-zoom-val" class="w-12 text-right text-xs font-medium text-surface-200">100%</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-secondary/20 bg-surface-950/60 px-5 py-3.5">
          <button
            id="hero-crop-reset"
            type="button"
            class="rounded-lg border border-secondary/25 px-3 py-1.5 text-xs font-medium text-secondary transition hover:bg-surface-850 hover:text-white"
          >
            Reset Center (50% · 50%)
          </button>
          <div class="flex items-center gap-2.5">
            <button
              id="hero-crop-cancel"
              type="button"
              class="rounded-lg border border-secondary/25 px-3.5 py-1.5 text-xs font-medium text-secondary transition hover:bg-surface-850 hover:text-white"
            >
              Cancel
            </button>
            <button
              id="hero-crop-apply"
              type="button"
              class="rounded-lg bg-surface-100 px-4 py-1.5 text-xs font-semibold text-surface-950 transition hover:bg-white"
            >
              Apply Framing
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div
      id="toast"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-xl border border-secondary/30 bg-surface-900/95 px-4 py-3 text-xs font-medium text-white shadow-2xl backdrop-blur-md transition-all duration-300 translate-y-20 opacity-0 pointer-events-none"
    >
      <span id="toast-icon" class="text-emerald-400">✓</span>
      <span id="toast-msg">Changes saved!</span>
    </div>
  </div>

  <script is:inline define:vars={{ initialSectionsData: allSections }}>
    // Darkroom Client-side State (preserve active tab across HMR/saves via URL hash & sessionStorage)
    const validSlugs = new Set(initialSectionsData.map((s) => s.slug));
    const hashSlug = window.location.hash ? window.location.hash.slice(1) : '';
    const storedSlug = sessionStorage.getItem('darkroom_active_slug') || '';
    let currentSectionSlug = validSlugs.has(hashSlug)
      ? hashSlug
      : validSlugs.has(storedSlug)
        ? storedSlug
        : initialSectionsData[0].slug;
    let sectionsState = JSON.parse(JSON.stringify(initialSectionsData));
    let replaceTargetIndex = null;
    let draggedIndex = null;

    const waterfall = document.getElementById('frames-waterfall');
    const statsCounter = document.getElementById('stats-counter');
    const viewLiveBtn = document.getElementById('view-live-btn');
    const sectionViewTitle = document.getElementById('section-view-title');
    const optimizerProfileLabel = document.getElementById('optimizer-profile-label');
    const categoryTabs = document.querySelectorAll('.category-tab');
    const singleReplaceInput = document.getElementById('single-replace-input');
    const bulkFileInput = document.getElementById('bulk-file-input');
    const dropzone = document.getElementById('dropzone');
    const addFrameBtn = document.getElementById('add-frame-btn');
    const resetBtn = document.getElementById('reset-btn');
    const savePublishBtn = document.getElementById('save-publish-btn');
    const saveStatusDot = document.getElementById('save-status-dot');
    const saveBtnText = document.getElementById('save-btn-text');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-msg');

    /**
     * Optimization Profiles for Azure Hosting:
     * Balances crisp Retina visual fidelity with minimal KB payload for fast loading.
     * - Hero Carousel: up to 2400px long edge, target <= 450 KB, WebP quality 86% -> 74%
     * - Gallery / Waterfall: up to 1600px long edge (1600x1200 or 1200x1600), target <= 280 KB, WebP quality 84% -> 72%
     */
    function getOptimizationProfile(sectionSlug) {
      if (sectionSlug === 'home-hero') {
        return {
          maxDimension: 2400,
          targetMaxBytes: 450 * 1024,
          initialQuality: 0.86,
          minQuality: 0.74,
          label: 'Hero Profile: WebP · Max 2400px · Target ≤ 450 KB',
        };
      }
      return {
        maxDimension: 1600,
        targetMaxBytes: 280 * 1024,
        initialQuality: 0.84,
        minQuality: 0.72,
        label: 'Gallery Profile: WebP · Max 1600px (4:3 / 3:4) · Target ≤ 280 KB',
      };
    }

    function formatBytes(bytes) {
      if (!bytes || bytes <= 0) return '0 KB';
      if (bytes < 1024) return `${bytes} B`;
      const kb = bytes / 1024;
      if (kb < 1024) return `${Math.round(kb)} KB`;
      return `${(kb / 1024).toFixed(2)} MB`;
    }

    function blobToDataUrl(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Failed to read image data'));
        reader.readAsDataURL(blob);
      });
    }

    /**
     * Converts and compresses an uploaded image File into an Azure-ready WebP blob.
     * Enforces maximum dimension cap while iteratively tuning quality to stay within byte budget.
     */
    async function optimizeImageForAzure(file, sectionSlug) {
      const cleanBaseName = file.name.replace(/\.[^/.]+$/, '');

      // Pass through SVG vector files untouched
      if (file.type === 'image/svg+xml') {
        const objectUrl = URL.createObjectURL(file);
        const dataUrl = await blobToDataUrl(file);
        return {
          src: objectUrl,
          dataUrl,
          alt: cleanBaseName,
          aspect: 'landscape',
          fileName: file.name,
          conversionMeta: `SVG · ${formatBytes(file.size)}`,
        };
      }

      const profile = getOptimizationProfile(sectionSlug);
      const bitmapUrl = URL.createObjectURL(file);

      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(bitmapUrl);

          const origW = img.naturalWidth || img.width;
          const origH = img.naturalHeight || img.height;
          const detectedAspect = origH > origW ? 'portrait' : 'landscape';

          // Scale proportionally so the longest side never exceeds profile.maxDimension (never upscale)
          const longestEdge = Math.max(origW, origH);
          const scale = longestEdge > profile.maxDimension ? profile.maxDimension / longestEdge : 1;
          const targetW = Math.max(1, Math.round(origW * scale));
          const targetH = Math.max(1, Math.round(origH * scale));

          const canvas = document.createElement('canvas');
          canvas.width = targetW;
          canvas.height = targetH;

          const ctx = canvas.getContext('2d');
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(img, 0, 0, targetW, targetH);

          // Iteratively encode WebP to find the highest quality that fits within targetMaxBytes
          let currentQuality = profile.initialQuality;

          function attemptEncode() {
            canvas.toBlob(
              async (blob) => {
                if (!blob) {
                  reject(new Error('Image encoding failed'));
                  return;
                }

                if (blob.size > profile.targetMaxBytes && currentQuality > profile.minQuality + 0.01) {
                  currentQuality = Math.max(profile.minQuality, currentQuality - 0.04);
                  attemptEncode();
                  return;
                }

                const optimizedUrl = URL.createObjectURL(blob);
                const dataUrl = await blobToDataUrl(blob);
                const savedRatio =
                  file.size > blob.size
                    ? Math.round(((file.size - blob.size) / file.size) * 100)
                    : 0;
                const savingsBadge = savedRatio > 0 ? ` (-${savedRatio}%)` : '';
                const webpFileName = `${cleanBaseName.toLowerCase().replace(/[^a-z0-9-_]+/g, '-')}.webp`;

                resolve({
                  src: optimizedUrl,
                  dataUrl,
                  alt: cleanBaseName,
                  aspect: detectedAspect,
                  fileName: webpFileName,
                  conversionMeta: `WebP · ${targetW}×${targetH} · ${formatBytes(blob.size)}${savingsBadge}`,
                });
              },
              'image/webp',
              currentQuality
            );
          }

          attemptEncode();
        };

        img.onerror = () => {
          URL.revokeObjectURL(bitmapUrl);
          reject(new Error('Could not decode image file'));
        };

        img.src = bitmapUrl;
      });
    }

    function getCurrentSection() {
