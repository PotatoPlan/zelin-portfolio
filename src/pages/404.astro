---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Frame Not Found">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-6 py-28 text-center">
    <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 font-mono text-xs text-amber-300">
      ERROR 404 // UNEXPOSED FRAME
    </span>
    <h1 class="mt-5 font-display text-5xl text-stone-100 sm:text-6xl">
      This page slipped out of focus.
    </h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-stone-400">
      The URL you’re looking for doesn’t exist or has moved to another series in the archive.
    </p>
    <div class="mt-8 flex items-center gap-3">
      <a
        href="/"
        class="rounded-full bg-amber-500 px-6 py-2.5 text-xs font-semibold text-stone-950 transition hover:bg-amber-400"
      >
        Return Home
      </a>
      <a
        href="/gallery"
        class="rounded-full border border-stone-700 bg-stone-900 px-6 py-2.5 text-xs font-medium text-stone-200 transition hover:border-amber-400"
      >
        Browse Portfolio
      </a>
    </div>
  </section>
</BaseLayout>
