---
import { siteConfig } from '../data/site';
import { resolveMediaUrl } from '../lib/media';

const { portfolioDownload } = siteConfig;
const downloadUrl = resolveMediaUrl(portfolioDownload.fileUrl);
---

{portfolioDownload.enabled && (
  <section class="relative overflow-hidden rounded-3xl border border-secondary/25 bg-gradient-to-br from-surface-850 via-surface-900 to-[#22252b] p-8 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05)] sm:p-10">
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-secondary/10 blur-3xl"></div>
    <div class="relative grid items-center gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-3 py-1 font-mono text-xs text-surface-200">
          <span>OFFLINE EDITION</span>
          <span class="text-secondary">&middot;</span>
          <span>UPDATED {portfolioDownload.updatedAt.toUpperCase()}</span>
        </div>

        <h2 class="mt-4 font-display text-3xl text-surface-100 sm:text-4xl">
          {portfolioDownload.title}
        </h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-surface-200/80 sm:text-base">
          {portfolioDownload.subtitle}
        </p>

        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {portfolioDownload.highlights.map((item) => (
            <li class="flex items-start gap-2 text-xs text-surface-200/85 sm:text-sm">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-secondary"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col items-start gap-3 lg:col-span-4 lg:items-end">
        <a
          href={downloadUrl}
          download={portfolioDownload.fileName}
          class="inline-flex w-full items-center justify-center gap-2.5 rounded-2xl bg-surface-100 px-6 py-3.5 text-sm font-semibold text-surface-950 shadow-lg shadow-black/30 transition hover:bg-secondary-light sm:w-auto"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 20h16" />
          </svg>
          <span>Download Portfolio PDF</span>
        </a>

        <a
          href={downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl border border-secondary/25 bg-surface-950/60 px-5 py-2.5 font-mono text-xs text-surface-200 transition hover:border-secondary-light/60 hover:text-white sm:w-auto"
        >
          <span>Preview in Browser</span>
          <span>&nearr;</span>
        </a>

        <p class="font-mono text-[11px] text-secondary">
          Format: PDF &middot; Size: {portfolioDownload.fileSize}
        </p>
      </div>
    </div>
  </section>
)}
