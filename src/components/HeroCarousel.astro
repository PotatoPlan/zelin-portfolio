---
/**
 * Hero Background Carousel Component
 * Features a seamless Left-to-Right gradient fade from the solid #17191C
 * theme background on the left into the 5-photo imagery carousel on the right.
 */
import homeHeroData from '../data/homeHero.json';

interface Slide {
  src: string;
  title: string;
  meta: string;
  alt: string;
  focusX?: number;
  focusY?: number;
  zoom?: number;
}

const slides: Slide[] = homeHeroData;
---

<div id="hero-carousel-root" class="pointer-events-none absolute inset-0 overflow-hidden select-none" aria-label="Motorsport photo carousel" role="region">
  <!-- Slides Container with True CSS Alpha-Mask (Seamless left-to-right & vertical feathering) -->
  <div
    class="relative h-full w-full hero-mask-fade"
  >
    {slides.map((slide, idx) => (
      <div
        class:list={[
          'hero-carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out',
          idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0',
        ]}
        data-slide-index={idx}
        aria-hidden={idx === 0 ? 'false' : 'true'}
      >
        <img
          src={slide.src}
          alt={slide.alt}
          class="h-full w-full object-cover"
          style={`object-position: ${slide.focusX ?? 65}% ${slide.focusY ?? 50}%; transform: scale(${slide.zoom ?? 1}); transform-origin: ${slide.focusX ?? 65}% ${slide.focusY ?? 50}%;`}
          loading={idx === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}
  </div>

  <!-- Bottom-Right Interactive Carousel Controls -->
  <div class="pointer-events-auto absolute bottom-6 right-6 z-30 hidden sm:flex items-center gap-3 rounded-full border border-secondary/25 bg-surface-950/85 px-4 py-2 backdrop-blur-md shadow-lg shadow-black/50">
    <!-- Prev Button -->
    <button
      id="hero-carousel-prev"
      type="button"
      aria-label="Previous slide"
      class="flex h-7 w-7 items-center justify-center rounded-full text-secondary transition hover:bg-secondary/15 hover:text-white"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Slide Indicators / Dots -->
    <div class="flex items-center gap-1.5" id="hero-carousel-dots">
      {slides.map((slide, idx) => (
        <button
          type="button"
          data-dot-index={idx}
          aria-label={`Go to slide ${idx + 1}: ${slide.title}`}
          class:list={[
            'hero-carousel-dot h-1.5 rounded-full transition-all duration-300',
            idx === 0 ? 'w-6 bg-surface-100' : 'w-2 bg-secondary/40 hover:bg-secondary',
          ]}
        ></button>
      ))}
    </div>

    <!-- Next Button -->
    <button
      id="hero-carousel-next"
      type="button"
      aria-label="Next slide"
      class="flex h-7 w-7 items-center justify-center rounded-full text-secondary transition hover:bg-secondary/15 hover:text-white"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Slide Counter & Label -->
    <div class="ml-1 pl-2 border-l border-secondary/20 font-mono text-[11px] text-secondary">
      <span id="hero-carousel-counter" class="text-surface-100 font-medium">01</span>
      <span>/ {String(slides.length).padStart(2, '0')}</span>
    </div>
  </div>
</div>

<style>
  .hero-mask-fade {
    /* Wide, ultra-smooth radial falloff anchored at top-left (10% 22%)
       so there is no visible circular edge or halo, even on bright sky backgrounds. */
    -webkit-mask-image:
      radial-gradient(
        ellipse 82% 115% at 10% 22%,
        rgba(0, 0, 0, 0.25) 0%,
        rgba(0, 0, 0, 0.28) 14%,
        rgba(0, 0, 0, 0.36) 28%,
        rgba(0, 0, 0, 0.50) 42%,
        rgba(0, 0, 0, 0.68) 56%,
        rgba(0, 0, 0, 0.85) 70%,
        rgba(0, 0, 0, 0.96) 84%,
        black 95%
      ),
      linear-gradient(to bottom, transparent 0%, black 6%, black 92%, transparent 100%);
    mask-image:
      radial-gradient(
        ellipse 82% 115% at 10% 22%,
        rgba(0, 0, 0, 0.25) 0%,
        rgba(0, 0, 0, 0.28) 14%,
        rgba(0, 0, 0, 0.36) 28%,
        rgba(0, 0, 0, 0.50) 42%,
        rgba(0, 0, 0, 0.68) 56%,
        rgba(0, 0, 0, 0.85) 70%,
        rgba(0, 0, 0, 0.96) 84%,
        black 95%
      ),
      linear-gradient(to bottom, transparent 0%, black 6%, black 92%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-composite: intersect;
  }
</style>

<script>
  function applyHeroDraftPreview(root: HTMLElement) {
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.get('preview') !== 'draft') return;
      const raw = localStorage.getItem('darkroom_preview_home-hero');
      if (!raw) return;
      const draft = JSON.parse(raw);
      if (!draft || !Array.isArray(draft.frames) || draft.frames.length === 0) return;

      const maskContainer = root.querySelector('.hero-mask-fade');
      const dotsContainer = document.getElementById('hero-carousel-dots');
      const counter = document.getElementById('hero-carousel-counter');
      if (!maskContainer || !dotsContainer) return;

      maskContainer.innerHTML = '';
      dotsContainer.innerHTML = '';

      draft.frames.forEach((frame: any, idx: number) => {
        const fx = typeof frame.focusX === 'number' ? frame.focusX : 65;
        const fy = typeof frame.focusY === 'number' ? frame.focusY : 50;
        const zoom = typeof frame.zoom === 'number' ? frame.zoom : 1;

        const slideEl = document.createElement('div');
        slideEl.className = `hero-carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
        }`;
        slideEl.setAttribute('data-slide-index', String(idx));
        slideEl.setAttribute('aria-hidden', idx === 0 ? 'false' : 'true');

        const imgEl = document.createElement('img');
        imgEl.src = frame.src;
        imgEl.alt = frame.alt || `Slide ${idx + 1}`;
        imgEl.className = 'h-full w-full object-cover';
        imgEl.style.objectPosition = `${fx}% ${fy}%`;
        imgEl.style.transform = `scale(${zoom})`;
        imgEl.style.transformOrigin = `${fx}% ${fy}%`;
        slideEl.appendChild(imgEl);
        maskContainer.appendChild(slideEl);

        const dotBtn = document.createElement('button');
        dotBtn.type = 'button';
        dotBtn.setAttribute('data-dot-index', String(idx));
        dotBtn.setAttribute('aria-label', `Go to slide ${idx + 1}: ${frame.alt || ''}`);
        dotBtn.className = `hero-carousel-dot h-1.5 rounded-full transition-all duration-300 ${
          idx === 0 ? 'w-6 bg-surface-100' : 'w-2 bg-secondary/40 hover:bg-secondary'
        }`;
        dotsContainer.appendChild(dotBtn);
      });

      if (counter && counter.nextElementSibling) {
        counter.textContent = '01';
        counter.nextElementSibling.textContent = `/ ${String(draft.frames.length).padStart(2, '0')}`;
      }
    } catch (_) {
      // Ignore invalid draft JSON
    }
  }

  function setupHeroCarousel() {
    const root = document.getElementById('hero-carousel-root');
    if (!root) return;

    applyHeroDraftPreview(root);

    const slides = root.querySelectorAll<HTMLElement>('.hero-carousel-slide');
    const dots = root.querySelectorAll<HTMLElement>('.hero-carousel-dot');
    const counter = document.getElementById('hero-carousel-counter');
    const prevBtn = document.getElementById('hero-carousel-prev');
    const nextBtn = document.getElementById('hero-carousel-next');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const intervalMs = 4500;

    function goToSlide(index: number) {
      if (index === currentIndex) return;
      const prevSlide = slides[currentIndex];
      const nextSlide = slides[index];

      // Update slides
      if (prevSlide) {
        prevSlide.classList.remove('opacity-100', 'z-10');
        prevSlide.classList.add('opacity-0', 'z-0');
        prevSlide.setAttribute('aria-hidden', 'true');
      }
      if (nextSlide) {
        nextSlide.classList.remove('opacity-0', 'z-0');
        nextSlide.classList.add('opacity-100', 'z-10');
        nextSlide.setAttribute('aria-hidden', 'false');
      }

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.remove('w-2', 'bg-secondary/40');
          dot.classList.add('w-6', 'bg-surface-100');
        } else {
          dot.classList.remove('w-6', 'bg-surface-100');
          dot.classList.add('w-2', 'bg-secondary/40');
        }
      });

      // Update counter
      if (counter) {
        counter.textContent = String(index + 1).padStart(2, '0');
      }

      currentIndex = index;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      goToSlide(next);
    }

    function prevSlide() {
      const prev = (currentIndex - 1 + slides.length) % slides.length;
      goToSlide(prev);
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(nextSlide, intervalMs);
    }

    function stopTimer() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Attach event listeners
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      nextSlide();
      startTimer();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      prevSlide();
      startTimer();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetIdx = Number(dot.dataset.dotIndex);
        if (!isNaN(targetIdx)) {
          goToSlide(targetIdx);
          startTimer();
        }
      });
    });

    // Pause on hover
    const heroSection = root.closest('section');
    heroSection?.addEventListener('mouseenter', stopTimer);
    heroSection?.addEventListener('mouseleave', startTimer);

    // Keyboard support when focused
    document.addEventListener('keydown', (e) => {
      if (document.activeElement && heroSection?.contains(document.activeElement)) {
        if (e.key === 'ArrowRight') {
          nextSlide();
          startTimer();
        } else if (e.key === 'ArrowLeft') {
          prevSlide();
          startTimer();
        }
      }
    });

    // Start auto-cycling
    startTimer();
  }

  setupHeroCarousel();
</script>