{
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/images/*", "/files/*", "/_astro/*", "/*.svg", "/*.png", "/*.jpg", "/*.webp", "/*.pdf"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/darkroom",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/darkroom/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/darkroom/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/_astro/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 404,
      "rewrite": "/404.html"
    },
    "403": {
      "statusCode": 404,
      "rewrite": "/404.html"
    }
  }
}
