# Optional: Base URL for external media storage (e.g. Cloudflare R2 custom domain or worker)
# Leave empty during initial setup to serve images from /public/images/
# Example later: PUBLIC_MEDIA_BASE_URL=https://media.yourdomain.com
PUBLIC_MEDIA_BASE_URL=

# Optional: Enable Cloudflare Image Transformation URLs (/cdn-cgi/image/...) when on Cloudflare
PUBLIC_CLOUDFLARE_IMAGE_RESIZING=false

# Optional: Contact form endpoint (e.g., Web3Forms access key, Formspree URL, or /api/contact on Azure Functions)
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_WEB3FORMS_KEY=
